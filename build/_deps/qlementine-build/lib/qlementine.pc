prefix=/usr/local
exec_prefix=${prefix}
libdir=/usr/local/lib
includedir=/usr/local/include

Name: qlementine
Description: Modern QStyle for desktop Qt applications.
Version: 1.5.2.0
URL: https://github.com/oclero/qlementine
Requires: Qt6Core Qt6Widgets Qt6Svg
Libs: -L${libdir} -lqlementine
Cflags: -I${includedir}

# target to preprocess a source file
src/locateNode.cpp.i:
	cd /Users/gobbi/Desktop/code/projects/gis/build && $(MAKE) $(MAKESILENT) -f _deps/nodeeditor-build/CMakeFiles/QtNodes.dir/build.make _deps/nodeeditor-build/CMakeFiles/QtNodes.dir/src/locateNode.cpp.i
.PHONY : src/locateNode.cpp.i

src/locateNode.s: src/locateNode.cpp.s
.PHONY : src/locateNode.s


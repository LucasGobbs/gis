{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "app: build",
      "type": "shell",
      "command": "make build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "app: run",
      "type": "shell",
      "command": "make run",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "app: test",
      "type": "shell",
      "command": "make test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "app: run under ASan/UBSan",
      "type": "shell",
      "command": "make run-asan",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "legacy (Odin): run",
      "type": "shell",
      "command": "make run",
      "options": {
        "cwd": "${workspaceFolder}/legacy"
      },
      "problemMatcher": []
    },
    {
      "label": "legacy (Odin): debug build",
      "type": "shell",
      "command": "make debug",
      "options": {
        "cwd": "${workspaceFolder}/legacy"
      },
      "problemMatcher": []
    }
  ]
}

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cpp: build",
      "type": "shell",
      "command": "make build-cpp",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "cpp: run",
      "type": "shell",
      "command": "make run-cpp",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "cpp: test",
      "type": "shell",
      "command": "make test-cpp",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "cpp: run under ASan/UBSan",
      "type": "shell",
      "command": "make run-cpp-asan",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "legacy (Odin): run",
      "type": "shell",
      "command": "make run",
      "options": {
        "cwd": "${workspaceFolder}/legacy"
      },
      "problemMatcher": []
    },
    {
      "label": "legacy (Odin): debug build",
      "type": "shell",
      "command": "make debug",
      "options": {
        "cwd": "${workspaceFolder}/legacy"
      },
      "problemMatcher": []
    }
  ]
}
